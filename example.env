# gpu-smi — example env. Copy to .env and fill in a real token. NEVER commit .env or token.txt.
#   copy example.env .env   (Linux: cp example.env .env && chmod 600 .env token.txt)
#
# Generate a token (>=16 chars, 32 bytes hex recommended):
#   Linux:   openssl rand -hex 32 > token.txt && chmod 600 token.txt
#   Windows: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_}) | Set-Content token.txt
#   Windows perms: icacls token.txt /inheritance:r /grant:r "$env:USERNAME:F"
#   Windows perms: icacls .env /inheritance:r /grant:r "$env:USERNAME:F"

# Option A (recommended): read token from file — avoids `ps` exposure.
# File may end with a newline; it is trimmed. Precedence: --token-file > GPU_SMI_TOKEN_FILE > --token > GPU_SMI_TOKEN.
GPU_SMI_TOKEN_FILE=./token.txt

# Option B: inline token (uncomment to use instead of the file).
#GPU_SMI_TOKEN=replace-with-openssl-rand-hex-32-output

# Serve usage once configured:
#   Linux:   set -a; source ./.env; set +a; ./gpu-smi --serve 8080 --listen 0.0.0.0
#   Windows: Get-Content ./.env | ForEach-Object { if ($_ -match '^\s*([^#=]+?)\s*=\s*(.*)\s*$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim(), 'Process') } }; .\gpu-smi.exe --serve 8080 --listen 0.0.0.0
# Scrape:  curl -H "Authorization: Bearer $(cat token.txt)" http://<host>:8080/metrics
# Prometheus: use bearer_token_file: 'token.txt' (not inline bearer_token).
# /health stays open (no auth) for load-balancer probes; / and /metrics require the token when one is set.
